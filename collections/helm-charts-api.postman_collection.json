  "info": {
    "_postman_id": "488a638d-e649-433b-9549-64a4f771d9fa",
    "name": "Helm Chart Repository ChartMuseum Charts API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Helm Chart Repository API defines the HTTP endpoints used by Helm clients to discover and download charts from a repository server. A chart repository is an HTTP server that houses an index.yaml file listing all available charts and optionally packaged chart archives (.tgz files). ChartMuseum and compatible implementations extend this with a JSON-based management API for listing, uploading, and deleting charts programmatically.\n\nContact Support:\n Name: Helm Project",
      "type": "text/plain"
    }
  }
