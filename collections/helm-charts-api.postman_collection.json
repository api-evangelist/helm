          "id": "c6cb079c-3372-4549-a861-94da4528c57c",
          "name": "Helm Download chart package",
          "request": {
            "name": "Helm Download chart package",
            "description": {
              "content": "Downloads a packaged Helm chart archive (.tgz file) for a specific chart name and version. The archive contains the Chart.yaml, values.yaml, templates, and other chart files. Helm clients use this endpoint after resolving chart references from the index.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "charts",
                "{{chartName}}-{{version}}.tgz"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of the chart repository",
                  "type": "any",
                  "value": "{{repository-host}}",
                  "key": "repository-host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/gzip"
              }
            ],
            "method": "GET",
            "auth": null
          },
