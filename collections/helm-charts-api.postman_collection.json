        {
          "id": "fe44928c-a40d-493a-b538-06dda690722d",
          "name": "Helm Download chart provenance file",
          "request": {
            "name": "Helm Download chart provenance file",
            "description": {
              "content": "Downloads the provenance file for a specific chart version. The provenance file contains a PGP signature used to verify the integrity and origin of the chart package. This endpoint is optional and only available for cryptographically signed charts.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "charts",
                "{{chartName}}-{{version}}.tgz.prov"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The hostname of the chart repository",
                  "type": "any",
                  "value": "{{repository-host}}",
                  "key": "repository-host"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/pgp-signature"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
